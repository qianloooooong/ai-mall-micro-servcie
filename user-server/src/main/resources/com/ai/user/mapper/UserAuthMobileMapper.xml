<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ai.user.mapper.UserAuthMobileMapper">

    <resultMap id="BaseResultMap" type="com.ai.user.pojo.entity.UserAuthMobile">
            <id property="id" column="id" />
            <result property="userId" column="user_id" />
            <result property="keyVersion" column="key_version" />
            <result property="mobileMasked" column="mobile_masked" />
            <result property="createTime" column="create_time" />
            <result property="deleted" column="deleted" />
            <result property="deleteTime" column="delete_time" />
    </resultMap>
    <update id="deleteAuthMobile">
        update user_auth_mobile
        set deleted = id, delete_time = #{now}
        where user_id = #{userId} and deleted = 0
    </update>

</mapper>
